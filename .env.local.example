# Development settings. Copy to .env.local (git-ignored); the Vite dev server
# answers /config.json from these, exactly as docker-entrypoint.sh does in the image.
#
# The ConfigHub instance. Unset, it is a server on this machine, http://localhost:9090.
# CONFIGHUB_URL=https://hub.confighub.com
# The OAuth client you registered for the dev server's origin
# (cub oauthclient create <name> --redirect-uri http://localhost:5173/).
CONFIGHUB_UI_OAUTH_CLIENT_ID=
# CONFIGHUB_POSTHOG_KEY=
