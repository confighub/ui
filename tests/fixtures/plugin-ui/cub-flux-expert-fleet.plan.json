{
  "inputs": {
    "objects": 46,
    "repoRoot": "/Users/alexis/code/examples"
  },
  "clusters": [
    {
      "name": "dev-1",
      "dir": "dev",
      "stage": "dev",
      "path": "gitops/flux/expert-fleet/clusters/dev"
    },
    {
      "name": "staging-1",
      "dir": "staging",
      "stage": "staging",
      "path": "gitops/flux/expert-fleet/clusters/staging"
    },
    {
      "name": "prod-1",
      "dir": "prod",
      "stage": "prod",
      "path": "gitops/flux/expert-fleet/clusters/prod"
    }
  ],
  "stages": [
    "dev",
    "staging",
    "prod"
  ],
  "reconcileOrder": [
    [
      "infrastructure"
    ],
    [
      "apps",
      "tenants"
    ],
    [
      "image-automation"
    ]
  ],
  "components": [
    {
      "name": "infrastructure",
      "base": "flux-infrastructure-base",
      "baseDir": "gitops/flux/expert-fleet/infrastructure/base",
      "stages": [
        {
          "name": "dev",
          "variants": [
            {
              "cluster": "dev-1",
              "space": "flux-infrastructure-dev-1",
              "target": "flux-targets/dev-1",
              "kustomization": "flux-system/infrastructure",
              "path": "gitops/flux/expert-fleet/infrastructure/dev",
              "departures": [
                "label environment=dev"
              ]
            }
          ]
        },
        {
          "name": "staging",
          "variants": [
            {
              "cluster": "staging-1",
              "space": "flux-infrastructure-staging-1",
              "target": "flux-targets/staging-1",
              "kustomization": "flux-system/infrastructure",
              "path": "gitops/flux/expert-fleet/infrastructure/staging",
              "departures": [
                "label environment=staging",
                "HelmRelease/edge-router replace /spec/values/replicaCount = 2"
              ]
            }
          ]
        },
        {
          "name": "prod",
          "variants": [
            {
              "cluster": "prod-1",
              "space": "flux-infrastructure-prod-1",
              "target": "flux-targets/prod-1",
              "kustomization": "flux-system/infrastructure",
              "path": "gitops/flux/expert-fleet/infrastructure/prod",
              "departures": [
                "label environment=prod",
                "GitRepository/fleet-repo replace /spec/ref/branch = production",
                "HelmRelease/edge-router replace /spec/values/replicaCount = 3"
              ]
            }
          ]
        }
      ],
      "helmReleases": [
        "edge-router: chart edge-router 2.4.x from HelmRepository platform-charts"
      ]
    },
    {
      "name": "apps",
      "base": "flux-apps-base",
      "baseDir": "gitops/flux/expert-fleet/apps/base/apptique",
      "dependsOn": [
        "infrastructure"
      ],
      "stages": [
        {
          "name": "dev",
          "variants": [
            {
              "cluster": "dev-1",
              "space": "flux-apps-dev-1",
              "target": "flux-targets/dev-1",
              "kustomization": "flux-system/apps",
              "path": "gitops/flux/expert-fleet/apps/dev",
              "departures": [
                "adds namespace.yaml",
                "namespace apptique-dev",
                "label environment=dev",
                "image nginx 1.27.3-alpine (written by image automation)",
                "Deployment/frontend replace /spec/replicas = 1",
                "substitutes cluster_name=dev-1",
                "substitutes environment=dev",
                "Flux spec.healthChecks[0].namespace = apptique-dev"
              ],
              "images": {
                "nginx": "1.27.3-alpine"
              }
            }
          ]
        },
        {
          "name": "staging",
          "variants": [
            {
              "cluster": "staging-1",
              "space": "flux-apps-staging-1",
              "target": "flux-targets/staging-1",
              "kustomization": "flux-system/apps",
              "path": "gitops/flux/expert-fleet/apps/staging",
              "departures": [
                "adds namespace.yaml",
                "namespace apptique-staging",
                "label environment=staging",
                "image nginx 1.27.2-alpine",
                "Deployment/frontend replace /spec/replicas = 2",
                "substitutes cluster_name=staging-1",
                "substitutes environment=staging",
                "Flux spec.healthChecks[0].namespace = apptique-staging"
              ],
              "images": {
                "nginx": "1.27.2-alpine"
              }
            }
          ]
        },
        {
          "name": "prod",
          "variants": [
            {
              "cluster": "prod-1",
              "space": "flux-apps-prod-1",
              "target": "flux-targets/prod-1",
              "kustomization": "flux-system/apps",
              "path": "gitops/flux/expert-fleet/apps/prod",
              "departures": [
                "adds namespace.yaml",
                "namespace apptique-prod",
                "label environment=prod",
                "image nginx 1.26.3-alpine",
                "Deployment/frontend replace /spec/replicas = 4",
                "substitutes cluster_name=prod-1",
                "substitutes environment=prod",
                "Flux spec.healthChecks[0].namespace = apptique-prod"
              ],
              "images": {
                "nginx": "1.26.3-alpine"
              }
            }
          ]
        }
      ],
      "inFlight": [
        "nginx: 1.27.3-alpine on dev-1; 1.27.2-alpine on staging-1; 1.26.3-alpine on prod-1"
      ]
    },
    {
      "name": "tenants",
      "base": "flux-tenants-base",
      "baseDir": "gitops/flux/expert-fleet/tenants/base/team-checkout",
      "dependsOn": [
        "infrastructure"
      ],
      "stages": [
        {
          "name": "dev",
          "variants": [
            {
              "cluster": "dev-1",
              "space": "flux-tenants-dev-1",
              "target": "flux-targets/dev-1",
              "kustomization": "flux-system/tenants",
              "path": "gitops/flux/expert-fleet/tenants/dev",
              "departures": [
                "label environment=dev",
                "GitRepository/team-checkout replace /spec/ref/branch = main"
              ]
            }
          ]
        },
        {
          "name": "staging",
          "variants": [
            {
              "cluster": "staging-1",
              "space": "flux-tenants-staging-1",
              "target": "flux-targets/staging-1",
              "kustomization": "flux-system/tenants",
              "path": "gitops/flux/expert-fleet/tenants/staging",
              "departures": [
                "label environment=staging",
                "GitRepository/team-checkout replace /spec/ref/branch = main"
              ]
            }
          ]
        },
        {
          "name": "prod",
          "variants": [
            {
              "cluster": "prod-1",
              "space": "flux-tenants-prod-1",
              "target": "flux-targets/prod-1",
              "kustomization": "flux-system/tenants",
              "path": "gitops/flux/expert-fleet/tenants/prod",
              "departures": [
                "label environment=prod",
                "GitRepository/team-checkout replace /spec/ref/branch = production"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "image-automation",
      "base": "flux-image-automation-base",
      "baseDir": "gitops/flux/expert-fleet/image-automation",
      "dependsOn": [
        "apps"
      ],
      "stages": [
        {
          "name": "dev",
          "variants": [
            {
              "cluster": "dev-1",
              "space": "flux-image-automation-dev-1",
              "target": "flux-targets/dev-1",
              "kustomization": "flux-system/image-automation",
              "path": "gitops/flux/expert-fleet/image-automation",
              "departures": [
                "adds imagerepository.yaml",
                "adds imagepolicy.yaml",
                "adds imageupdateautomation.yaml"
              ]
            }
          ]
        }
      ],
      "notes": [
        "one cluster uses this layer, so its whole directory is the base",
        "only on dev-1"
      ]
    }
  ],
  "sources": [
    {
      "kind": "HelmRepository",
      "name": "platform-charts",
      "url": "oci://ghcr.io/confighub/charts",
      "file": "gitops/flux/expert-fleet/infrastructure/base/sources/charts.yaml"
    },
    {
      "kind": "GitRepository",
      "name": "fleet-repo",
      "url": "https://github.com/confighub/examples",
      "branches": {
        "dev-1": "main",
        "prod-1": "production",
        "staging-1": "main"
      },
      "file": "gitops/flux/expert-fleet/infrastructure/base/sources/fleet-repo.yaml"
    },
    {
      "kind": "GitRepository",
      "name": "team-checkout",
      "url": "https://github.com/confighub/examples",
      "branches": {
        "dev-1": "main",
        "prod-1": "production",
        "staging-1": "main"
      },
      "file": "gitops/flux/expert-fleet/tenants/base/team-checkout/sync.yaml"
    }
  ],
  "writesToGit": [
    "ImageUpdateAutomation apptique-dev commits to branch main, path gitops/flux/expert-fleet/apps/dev, running on dev-1"
  ],
  "notInGit": [
    "which chart edge-router runs: HelmRelease edge-router pins it to \"2.4.x\", so helm-controller decides at reconcile time and what runs can change with no change in ConfigHub. Pin one exact version to close that, and to make a flattening verdict possible",
    "what the HelmReleases in infrastructure render: the charts are pulled at reconcile time",
    "apps: ${cluster_name}, ${environment}, supplied per cluster by postBuild"
  ],
  "tenants": [
    "team-checkout/team-checkout runs as ServiceAccount team-checkout, reading GitRepository team-checkout; governed as part of tenants"
  ],
  "boundary": [
    "gitops/flux/expert-fleet/clusters/dev/flux-system",
    "gitops/flux/expert-fleet/clusters/prod/flux-system",
    "gitops/flux/expert-fleet/clusters/staging/flux-system"
  ],
  "handover": [
    "keep each layer's Flux Kustomization under its own name and switch its sourceRef to an OCIRepository on the ConfigHub gateway, so Flux keeps its inventory and nothing is reinstalled",
    "first prove each variant renders exactly what Git renders today: infrastructure, apps, tenants, image-automation prune, so anything the release lacks is deleted",
    "suspend ImageUpdateAutomation apptique-dev: it would commit to Git that no longer deploys; its tag should become a proposed ConfigHub change on that variant",
    "GitRepository fleet-repo promotes by branch (dev-1 main, staging-1 main, prod-1 production); after handover the ChangeWorkflow's stages decide, not the branch",
    "GitRepository team-checkout promotes by branch (dev-1 main, staging-1 main, prod-1 production); after handover the ChangeWorkflow's stages decide, not the branch",
    "leave flux-system alone: flux bootstrap owns it, like the Sveltos management record"
  ]
}
